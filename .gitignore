# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
dist/
build/
target/
*.tsbuildinfo

# Environment
.env
.env.local
.env.production.local
.env.development.local

# Database
# WICHTIG: gitignore erkennt Kommentare NUR am Zeilenanfang, niemals inline.
# Ein Pattern mit "# ..." dahinter wird Teil des Patterns und matcht auf nichts.

# Alle Datenbank-Dateien (Production und Development)
# deckt ab: server/database.db, server/database.backup.db,
#           server/database/development.db, server/database/development.backup.*.db
*.db
*.db-shm
*.db-wal

# Timestamped Backups von sync-dev-db.sh
# z.B. server/database.db.backup.20260417_143724
*.db.backup.*

# Beiseitegelegte korrupte DB-Snapshots
# z.B. server/database/development.db.corrupted_backup
*.db.corrupted_backup

# Keep migration and seed SQL files (these should be versioned)
!server/database/migrations/*.sql
!server/database/seeds/*.sql

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop-ini

# Logs
logs/
*.log

# Testing
coverage/

# Tauri
desktop/src-tauri/target/
desktop/src-tauri/WixTools/

# Production builds
*.exe
*.dmg
*.deb
*.rpm
*.AppImage
GITHUB-SECRETS-VALUES.md

# SSH Keys (NEVER commit!)
.ssh/
*.key
*.pem
ssh-key-*
.env.ssh

# Backups (NEVER commit production data!)
backups/
*.backup.db

# ============================================
# GSD (Get Shit Done) Framework
# ============================================
# These are user-specific GSD installation files
# Project-specific GSD commands in .claude/commands/ are kept
.claude/get-shit-done/
.claude/gsd-file-manifest.json
.claude/agents/
.claude/hooks/
.claude/commands/gsd/
.claude/package.json
.claude/package-lock.json
.claude/node_modules/

# Temporaere git-Worktrees aus Agent-Laeufen
.claude/worktrees/

# Lokale Notiz-/Debugdatei, absichtlich nicht versioniert.
# Ohne diesen Eintrag zaehlt sie in `git status --porcelain` mit und die Release-Checkliste
# („git status muss sauber sein“) verleitet dazu, sie zu loeschen — genau das ist am 20.08.2026 passiert.
.claude/CLAUDETESTOUT.md

# Rohdaten der D-1-Kontrastmessung (Phase 14.2, Plan 10) — erzeugt, ~2 MB
desktop/tests/messungen/*-rohdaten.json
